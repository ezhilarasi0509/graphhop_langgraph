graph TD;
	start_node([start]):::first
	route(route)
	graph_search(graph)
	vector(vector)
	merge(merge)
	generate(generate)
	validate(validate)
	end_node([end]):::last
	start_node --> route;
	generate --> validate;
	graph_search -.-> merge;
	graph_search -.-> vector;
	merge --> generate;
	route -.-> graph_search;
	route -.-> vector;
	validate -.-> end_node;
	validate -.-> generate;
	vector --> merge;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
