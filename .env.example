# --- LLM: any OpenAI-compatible endpoint, used through LangChain's ChatOpenAI. Default = Groq free tier ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key
LLM_MODEL=openai/gpt-oss-120b
ROUTER_MODEL=openai/gpt-oss-20b

# --- Embeddings run locally (free, no rate limits) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# --- Stores (docker-compose.yml) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kgrag-password
PG_DSN=postgresql://kgrag:kgrag@localhost:5433/kgrag

# --- Tunables ---
MIN_CONFIDENCE=0.6
ER_THRESHOLD=0.88

# --- Optional: LangSmith tracing (free tier). Uncomment and add a key to see every LangGraph step ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
